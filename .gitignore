# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
# Stale build output left behind by a previous run — same shape as /.next/, and
# `git add -A` would otherwise sweep the whole of it into a commit.
/.next.stale/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev scripts (contain credentials — never commit)
# Pattern is /scripts/* rather than /scripts/ so a specific file can be
# un-ignored below: git does not descend into an ignored *directory*, so a
# negation under a bare `/scripts/` rule would have no effect.
/scripts/*
# Carries no credentials — it only compares two file hashes. Must be tracked so
# both repos ship the same check.
!/scripts/check-scoring-sync.sh
# Carries no credentials — it deletes iCloud duplicate files from .next. Must be
# tracked: `npm run build` runs it via prebuild, so an untracked copy would break
# the Netlify build with "No such file or directory" the moment it deployed.
!/scripts/clean-icloud-dupes.sh

# Local Netlify folder
.netlify
